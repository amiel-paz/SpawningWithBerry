# Production-length analogue of the original PySpawn ethylene example.
provider pyscf
geometry ethylene.xyz
geometry_units angstrom

num_states 3
initial_state 1
time_step 20 au
coupling_time_step 5 au
min_time_step 0.00244140625 au
minimum_nuclear_time_step 0.625 au
simulation_time 10335 au
random_seed 87062
initial_condition wigner
hessian ethylene_mp2_631gstar_hessian.txt
temperature 0

electronic_method sa_casscf
scf_method rhf
basis 6-31g*
charge 0
spin 0
active_electrons 2
active_orbitals 2
state_weights 0.3333333333333333 0.3333333333333333 0.3333333333333334
provider_option density_fit true
provider_option max_memory 2500
provider_option scf_conv_tol 1e-9
provider_option casscf_conv_tol 1e-8
provider_option casscf_max_cycle 50
provider_option spin_penalty 0.5
provider_option multistart_external_orbitals 1
provider_option orbital_selection overlap
provider_option active_space_overlap_min 0.7
provider_option ci_root_overlap_min 0.7
provider_option energy_gradient_consistency_tolerance 0.005
provider_option electronic_workers 1

coupling_mode nac
quantum_integrator cayley
spawn_strategy nac
spawn_metric nac_norm
spawn_threshold 3.0
population_to_spawn 0.01
spawn_overlap_max 0.6
spawn_cooldown 0
max_trajectories 32
max_energy_gap 0.0220495934
nac_gap_threshold 0.0220495934
pair_overlap_threshold 0.001
overlap_threshold 0.0001
regularization_threshold 0.0001
energy_tolerance 0.005
norm_tolerance 1e-6
output_every 1
run_directory run-production

observable bond cc_distance 0 1
observable bond ch_migration_0_4 0 4
observable bond ch_migration_0_5 0 5
observable bond ch_migration_1_2 1 2
observable bond ch_migration_1_3 1 3
observable dihedral torsion_1 2 0 1 4
observable dihedral torsion_2 3 0 1 5
