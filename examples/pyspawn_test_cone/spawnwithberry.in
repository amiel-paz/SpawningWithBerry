# Exact three-Cartesian embedding of PySpawn examples/test_cone/start.py.
provider custom
provider_option factory aims_berry.models.pyspawn_cone:pyspawn_test_cone_factory
geometry geometry.xyz
geometry_units bohr

num_states 2
initial_state 1
time_step 0.1 au
simulation_time 200.0 au
random_seed 0
initial_condition file
momenta momenta.txt

electronic_method analytic_model
coupling_mode npi
quantum_integrator cayley
spawn_metric tdc
spawn_momentum isotropic
spawn_threshold 0.7853981633974483
population_to_spawn 0.0
spawn_overlap_max 0.8
max_trajectories 100
pair_overlap_threshold 0.0
regularization_threshold 1e-8
min_time_step 0.0000244140625 au
norm_tolerance 1e-8
cumulative_norm_tolerance 1e-8
quantum_energy_policy record
classical_energy_policy record

gaussian_widths 6.0 6.0 6.0
nuclear_masses 1822.0 1822.0 1e30
run_directory run-spawnwithberry
